# Copy to .env (never commit .env).
ENERGY_STORE=local                 # local | azurite | azure
ENERGY_STORE_ROOT=artifacts/store
ENERGY_CONTAINER=energy
# ENERGY_AZURE_CONNECTION_STRING=   # or ENERGY_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
ENERGY_API_KEY=                     # optional; when set, clients must send X-API-Key
ENERGY_API_CORS_ORIGINS=            # empty keeps CORS off
ENERGY_API_URL=http://127.0.0.1:8000
